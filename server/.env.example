APIFY_TOKEN=
ANTHROPIC_API_KEY=
# Search terms sent to the Apify TikTok scraper (comma-separated)
APIFY_SEARCH_QUERIES=wildfire,house fire,flood,earthquake,hurricane,tornado
APIFY_RESULTS_PER_QUERY=20
# Ignore posts older than N days (filtered server-side before classification)
APIFY_MAX_POST_AGE_DAYS=3
# How long scraped results are cached before re-running the scraper
APIFY_CACHE_TTL_SECONDS=900
CLIENT_ORIGIN=http://localhost:5173

# OpenTelemetry (defaults point at the local docker-compose LGTM stack)
OTEL_SERVICE_NAME=disasterwarning-server
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SDK_DISABLED=false
